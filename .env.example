JWT_SECRET=change-me-to-a-random-secret

# MusicBrainz vyžaduje identifikující User-Agent (jinak riskuješ rate-limit/ban IP).
# https://musicbrainz.org/doc/MusicBrainz_API/Rate_Limiting
MUSICBRAINZ_USER_AGENT=VaultPersonal/0.1 (tvuj@email.example)

# ListenBrainz uživatelské jméno, pro které se generují /recommendations/*
# (jednouživatelský server -> serverová konfigurace, ne per-device identita).
LISTENBRAINZ_USERNAME=demo-user

# Výchozí (zakomentováno) čeká na vlastní self-hostnutou ListenBrainz instanci
# -- pro reálný účet na veřejném listenbrainz.org odkomentuj a nastav uživatelské
# jméno výše na svůj skutečný účet:
# LISTENBRAINZ_BASE_URL=https://api.listenbrainz.org

# Cesta na hostiteli k tvé hudební knihovně (externí HDD/NAS) -- namapuje se
# do kontejneru jako /data/local-music (read-only), viz docker-compose.yml.
# `POST /library/scan` ji pak projde a zaeviduje nalezené soubory jako
# available bez provisioningu. Stejná proměnná funguje na Windows i na
# 24/7 Linux serveru, mění se jen její hodnota:
#   Windows (vývoj):     MUSIC_DIR=D:/Music
#   Linux (server):      MUSIC_DIR=/mnt/music-hdd
# Necháš-li prázdné/nenastavené, použije se ./local-music vedle repozitáře.
MUSIC_DIR=./local-music
