JWT_SECRET=change-me-to-a-random-secret

# MusicBrainz vyžaduje identifikující User-Agent (jinak riskuješ rate-limit/ban IP).
# https://musicbrainz.org/doc/MusicBrainz_API/Rate_Limiting
MUSICBRAINZ_USER_AGENT=VaultPersonal/0.1 (tvuj@email.example)
# (Wikidata/Wikipedia pro životopis interpreta mají stejnou User-Agent
# politiku -- docker-compose.yml jim posílá tuhle stejnou hodnotu.)

# ListenBrainz uživatelské jméno, pro které se generují /recommendations/*
# (jednouživatelský server -> serverová konfigurace, ne per-device identita).
LISTENBRAINZ_USERNAME=demo-user

# Výchozí (zakomentováno) čeká na vlastní self-hostnutou ListenBrainz instanci
# -- pro reálný účet na veřejném listenbrainz.org odkomentuj a nastav uživatelské
# jméno výše na svůj skutečný účet:
# LISTENBRAINZ_BASE_URL=https://api.listenbrainz.org

# Cesta na hostiteli k tvé hudební knihovně (externí HDD/NAS) -- namapuje se
# do kontejneru jako /data/local-music (read-only), viz docker-compose.yml.
# `POST /library/scan` ji pak projde a zaeviduje nalezené soubory jako
# available bez provisioningu. Stejná proměnná funguje na Windows i na
# 24/7 Linux serveru, mění se jen její hodnota:
#   Windows (vývoj):     MUSIC_DIR=D:/Music
#   Linux (server):      MUSIC_DIR=/mnt/music-hdd
# Necháš-li prázdné/nenastavené, použije se ./local-music vedle repozitáře.
MUSIC_DIR=./local-music

# Soulseek účet pro slskd (ingestion engine, viz backend/app/providers.py a
# docker-compose.yml) -- jméno/heslo si vymyslíš, žádná registrace předem
# (https://www.slsknet.org), jen ať se na Soulseek síti dřív nepoužívají.
SLSKD_SLSK_USERNAME=change-me
SLSKD_SLSK_PASSWORD=change-me

# Sdílený secret mezi slskd a workerem -- worker ho posílá v `X-API-Key`
# hlavičce, slskd ho čeká zabalený v `role=...;cidr=...;<tohle>` (viz
# docker-compose.yml). Vygeneruj: openssl rand -base64 32
SLSKD_API_KEY_SECRET=change-me

# composite (výchozí) = slskd -> yt-dlp fallback; "placeholder" pro dev bez
# obojího, "slskd"/"youtube" pro test jednoho providera zvlášť.
MEDIA_PROVIDER=composite

# Mullvad VPN (WireGuard) pro gluetun -- slskd jde VÝHRADNĚ přes tenhle
# tunel (viz docker-compose.yml), aby tvoje sdílená knihovna/Soulseek provoz
# nikdy nešly z tvojí skutečné IP. Postup:
#   1. Přihlas se na mullvad.net -> "WireGuard configuration"
#   2. Vygeneruj konfiguraci (stačí jeden klíč, na serveru/městě dole nezáleží)
#   3. Stáhni JSON variantu, otevři ji
#   4. Zkopíruj pole "PrivateKey" a "Address" (jen IPv4 část, ne IPv6) sem
MULLVAD_WIREGUARD_PRIVATE_KEY=change-me
MULLVAD_WIREGUARD_ADDRESSES=change-me

# Který Mullvad server/město použít -- na hodnotě moc nezáleží, jen ať
# existuje (seznam měst viz mullvad.net/servers). Anglicky, s velkým písmenem.
MULLVAD_SERVER_CITIES=Prague

# gluetun control API key -- worker uses it to switch Mullvad server when YouTube blocks an IP
GLUETUN_CONTROL_API_KEY=change-me

# Set to http://gluetun:8888 to route YouTube downloads through the VPN too
# YTDLP_PROXY=
